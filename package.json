{
  "name": "double-entry-ledger",
  "version": "1.0.0",
  "description": "Double-entry ledger HTTP service",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/src/index.js",
    "migrate": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "reconcile": "ts-node scripts/reconcile.ts",
    "seed": "ts-node scripts/seed-dev-data.ts",
    "test": "jest",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:accounts": "jest --testPathPattern=test/integration/accounts.test.ts",
    "test:api": "jest --testPathPattern=test/integration/api.test.ts",
    "test:balance-invariant": "jest --testPathPattern=test/integration/balance-invariant.test.ts",
    "test:balance": "jest --testPathPattern=test/integration/balance.test.ts",
    "test:concurrency": "jest --testPathPattern=test/integration/concurrency.test.ts",
    "test:db-connection": "jest --testPathPattern=test/integration/db-connection.test.ts",
    "test:reconciliation": "jest --testPathPattern=test/integration/reconciliation.test.ts",
    "test:statement": "jest --testPathPattern=test/integration/statement.test.ts",
    "test:transfers": "jest --testPathPattern=test/integration/transfers.test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gitk": "^0.47.0",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
