{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["jest"]
  },
  "include": ["src", "test", "scripts", "knexfile.ts"],
  "exclude": ["node_modules", "dist"]
}